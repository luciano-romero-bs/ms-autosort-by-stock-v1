# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cron (Vercel agrega automáticamente "Authorization: Bearer <este valor>"
# al invocar el Cron Job si esta env var existe en el proyecto)
CRON_SECRET=change-me

# Panel auth (basic auth)
PANEL_USER=admin
PANEL_PASS=change-me

# Nota: las credenciales de cada tienda de Shopify (dominio + admin token) NO
# van acá — se cargan desde el propio panel ("+ Agregar tienda"), que las
# guarda en la tabla `stores` de Supabase. Así se puede sumar una tienda
# nueva sin tocar env vars ni redeployar. Ver design.md sección 4.

# Para desarrollo local: copiar este archivo a .env.local (gitignored) y
# completar los valores reales. "vercel dev" lo carga automáticamente.
